# Narra configuration. Copy to .env (and set in your host's dashboard for prod).
# Leave the SUPABASE_* / STRIPE_* blocks empty to run in open local mode
# (no accounts, no quota, no billing) — exactly like the original Narra.

# --- Engine ---------------------------------------------------------------
# mlx (Apple Silicon dev) | torch (hosted CPU, e.g. HF Spaces) | auto (default)
TTS_ENGINE=auto
HOST=127.0.0.1
PORT=8000

# Comma-separated frontend origins for CORS. Use "*" only in dev.
ALLOWED_ORIGINS=*

# --- Rate limiting + owner bypass (works without Supabase) ----------------
# OWNER_KEY: a long random secret. Requests sending it as the X-Narra-Key
# header get UNLIMITED access (skip rate limit + quota) — that's how you give
# yourself unlimited use. Leave empty to disable the owner bypass.
OWNER_KEY=
# Per-IP synthesis caps for everyone else. 0 = unlimited.
RATE_LIMIT_PER_MIN=8
RATE_LIMIT_PER_DAY=200

# --- Supabase (enables auth + usage quota) --------------------------------
# From Supabase: Project Settings -> API and -> API/JWT.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (enables the Pro subscription) --------------------------------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APP_BASE_URL=http://127.0.0.1:8000
